{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cli-config:claude:settings:v1",
  "$comment": "Target: Claude Code 2.x settings format; local Schema v1; source: https://code.claude.com/docs/en/configuration; checked 2026-08-27.",
  "title": "Claude Code settings",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "model": {
      "type": "string",
      "minLength": 1
    },
    "modelOverrides": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "env": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  },
  "required": [
    "model",
    "env"
  ]
}
