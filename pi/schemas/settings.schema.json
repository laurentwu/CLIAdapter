{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cli-config:pi:settings:v1",
  "$comment": "Target: PI v0.85.1 settings.json format at commit d981de1229ef899957bbe968bc8dcda02a21f477; local Schema v1; source: https://github.com/earendil-works/pi/blob/v0.85.1/packages/coding-agent/docs/settings.md.",
  "title": "Pi settings.json",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "$schema": {
      "type": "string"
    },
    "defaultProvider": {
      "type": "string",
      "minLength": 1
    },
    "defaultModel": {
      "type": "string",
      "minLength": 1
    },
    "defaultThinkingLevel": {
      "type": "string",
      "enum": [
        "off",
        "minimal",
        "low",
        "medium",
        "high",
        "xhigh"
      ]
    }
  },
  "required": [
    "defaultProvider",
    "defaultModel",
    "defaultThinkingLevel"
  ]
}
