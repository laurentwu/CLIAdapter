{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "urn:cli-config:codebuddy:models:v1",
  "$comment": "Target: CodeBuddy models.json custom model format; local Schema v1; source: https://www.codebuddy.cn/docs/ide/Features/models; checked 2026-08-29.",
  "title": "CodeBuddy models.json",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "LanguageModel": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "vendor": {
          "type": "string",
          "minLength": 1
        },
        "apiKey": {
          "type": "string"
        },
        "maxInputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "maxOutputTokens": {
          "type": "integer",
          "minimum": 1
        },
        "url": {
          "type": "string",
          "pattern": "^(https?://.+/chat/completions|<base-url>)$"
        },
        "supportsToolCall": {
          "type": "boolean"
        },
        "supportsImages": {
          "type": "boolean"
        },
        "supportsReasoning": {
          "type": "boolean"
        }
      },
      "required": [
        "id",
        "name",
        "vendor",
        "apiKey",
        "maxInputTokens",
        "maxOutputTokens",
        "url",
        "supportsToolCall",
        "supportsImages",
        "supportsReasoning"
      ]
    }
  },
  "properties": {
    "models": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/definitions/LanguageModel"
      }
    },
    "availableModels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "required": [
    "models"
  ]
}
