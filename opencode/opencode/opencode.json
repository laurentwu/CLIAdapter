{
  "$schema": "https://opencode.ai/config.json",
  "model": "opencode/<model-id>",
  "provider": {
    "opencode": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "OpenCode Zen",
      "options": {
        "baseURL": "https://opencode.ai/zen/v1",
        "apiKey": "<Your API Key>"
      },
      "models": {
        "<model-id>": {
          "name": "<model-name>",
          "reasoning": true
        }
      }
    }
  }
}
