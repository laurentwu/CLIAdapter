{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai-coding-plan/<model-id>",
  "provider": {
    "zai-coding-plan": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI Coding Plan",
      "options": {
        "baseURL": "https://api.z.ai/api/coding/paas/v4",
        "apiKey": "<Your API Key>"
      },
      "models": {
        "<model-id>": {
          "name": "<model-name>",
          "reasoning": true
        }
      }
    }
  }
}
