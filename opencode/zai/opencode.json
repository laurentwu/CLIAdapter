{
  "$schema": "https://opencode.ai/config.json",
  "model": "zai/<model-id>",
  "provider": {
    "zai": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Z.AI",
      "options": {
        "baseURL": "https://api.z.ai/api/paas/v4",
        "apiKey": "<your-api-key>"
      },
      "models": {
        "<model-id>": {
          "name": "<model-name>",
          "reasoning": true
        }
      }
    }
  }
}
