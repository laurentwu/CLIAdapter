{
  "$schema": "https://opencode.ai/config.json",
  "model": "deepseek/<model-id>",
  "provider": {
    "deepseek": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "DeepSeek",
      "options": {
        "baseURL": "https://api.deepseek.com",
        "apiKey": "<Your API Key>"
      },
      "models": {
        "<model-id>": {
          "name": "<model-name>",
          "reasoning": true
        }
      }
    }
  }
}
